PORT=3000
PUBLIC_BASE_URL=https://your-service.onrender.com
DELIVERY_SECRET=replace-with-another-random-secret
PDF_PATH=./ebook-programador-junior.pdf
PAYMENT_PHONE=replace-with-your-multicaixa-express-number
EBOOK_PRICE_AOA=24000
MUKUTU_API_URL=https://ocr-api-sdte.onrender.com/receipt-validation/v1/validate
# SendGrid takes precedence over the generic SMTP settings when this key is set.
SENDGRID_API_KEY=replace-with-sendgrid-api-key
EMAIL_REMETENTE="E-BOOK <sender@example.com>"
# Generic SMTP fallback when SENDGRID_API_KEY is unset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-email@gmail.com
DELIVERY_EXPIRY_HOURS=72
